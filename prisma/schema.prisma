generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userName      String
  email         String
  passwordHash  String
  webHookHashes Webhookhash[]
}

model Webhookhash {
  id                 Int           @id @default(autoincrement())
  urlString          String        @unique
  user_detail_id     Int
  createdAt          DateTime      @default(now())
  webHookFetchedData Webhookdata[]
  user               User          @relation(fields: [user_detail_id], references: [id])
}

model Webhookdata {
  id          Int         @id @default(autoincrement())
  webHookId   Int
  data        Json?
  createdAt   DateTime    @default(now())
  apiCallUrl  String
  typeOfCall  String
  webHookHash Webhookhash @relation(fields: [webHookId], references: [id])
  tempField   String?
}
