# Copy to `.env` for Prisma CLI (migrate, generate) and local tooling.
# Copy the same values to `.dev.vars` for `wrangler dev` (Cloudflare Workers local dev).
# Set production secrets via `wrangler secret put <NAME>` or the Cloudflare dashboard.

# Prisma Accelerate — runtime database URL (used by the Worker / app)
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY"

# Direct PostgreSQL — migrations only (prisma.config.ts); not used at runtime
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT signing secret (use a long random string in production)
SECRET_KEY="change-me-to-a-long-random-secret"

# bcrypt cost factor (10–12 is typical; must be a number in Worker bindings)
saltRounds=10

# Upstash Redis REST API — maps webhook URL slugs to DB ids for fast lookup
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"
